<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Thank You — <%= agency?.name || 'Travel CRM' %></title>
  <style>
    body { margin:0; font-family: Arial, Helvetica, sans-serif; background:#f4f6f8; color:#0f172a; }
    .card { max-width:520px; margin:60px auto; background:#fff; border-radius:10px; padding:36px; text-align:center; box-shadow:0 8px 24px rgba(15,23,42,.08); }
    .icon { font-size:48px; margin-bottom:12px; }
    h1 { margin:0 0 12px; font-size:24px; }
    p { color:#475569; line-height:1.5; }
    .ref { margin-top:20px; font-weight:bold; font-size:16px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">✅</div>
    <h1>Thank You!</h1>
    <p>Your inquiry has been confirmed. A confirmation email has been sent to your inbox — please keep it as your record.</p>
    <p>Our team will contact you shortly.</p>
    <div class="ref">Reference: <%= inquiry.inquiryReference %></div>
  </div>
</body>
</html>
