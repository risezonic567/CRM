# =============================================================================
# Travel CRM — Backend Environment
# Copy this file to .env and fill in real values:
#   copy .env.example .env
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/travelcrm

# --- Redis (optional) ---
# Set USE_REDIS=true and REDIS_URL when you have Redis ready
USE_REDIS=false
# REDIS_URL=redis://127.0.0.1:6379

# --- JWT / Auth ---
# Access token lives in frontend Redux; refresh token in httpOnly cookie
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public customer confirm link token (signed separately)
PUBLIC_TOKEN_SECRET=change_me_public_confirm_secret_min_32
PUBLIC_TOKEN_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- URLs ---
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# --- Flight search provider ---
# duffel (default) | flightmcp | serpapi | mock
# --- PNR Converter (optional — without key, local GDS parser is used) ---
# See docs/PNR_AUTHORIZE_FLOW.md before changing adapter headers/body
# PNR_CONVERTER_API_KEY=
# PNR_CONVERTER_BASE_URL=https://api.pnrconverter.com/api

# --- Pricing defaults ---
# Inquiry authorize flow always uses merchant fee 0 (supplier + markup = total).
# MERCHANT_FEE_PERCENT remains for legacy Agency settings UI only.
DEFAULT_MARKUP=50
MERCHANT_FEE_PERCENT=0
DEFAULT_CURRENCY=USD

# --- Nodemailer / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=TravelCRM <no-reply@youragency.com>

# --- Seed admin (used only by npm run seed) ---
SEED_ADMIN_EMAIL=admin@travelcrm.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_AGENCY_NAME=Travel CRM Agency

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_MAX=30
